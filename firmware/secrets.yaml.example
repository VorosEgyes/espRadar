# Template — copy to secrets.yaml and fill in.

# `esphome run` will refuse to start if any of these are missing.

# ============================================================================
# Per-node API encryption keys
# ============================================================================
#
# The `seime/openhab-esphome` binding identifies each node by the
# (device_name, encryption_key) pair. Sharing the same key across
# multiple nodes causes "handshake failure" / "CONNECTION_CLOSED"
# in the openHAB log (the noise protocol derives a per-device
# session key from the device name, and reusing the same base key
# across devices breaks the noise handshake).
#
# Therefore, every node MUST have its own encryption key. The
# `scripts/new_node.sh <név>` script generates a fresh 32-byte
# random key for each new node and appends it to this file as
# `api_encryption_key_<név>:`. The corresponding `firmware/<név>.yaml`
# references that key via `!secret api_encryption_key_<név>`.
#
# Backwards compatibility: the v1.0.0 release used the legacy
# `api_encryption_key:` (shared across all nodes). The v1.1.0
# release moved every node to a per-node key — the `radar` node's
# key is `api_encryption_key_radar:`. The v1.0.0 firmware on the D1
# mini (SHA-256 fb0ea4f06ddc406ce41632df86615962bbf2df0f50d0466072a4f7e537398d3c)
# can be flashed with the v1.1.0 firmware over USB, after which it
# will use the per-node `api_encryption_key_radar:` and connect
# to the openHAB binding without `CONNECTION_CLOSED`.
#
# Regenerate any key with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"

# Per-node keys (one per firmware/*.yaml). Add new keys here as
# `scripts/new_node.sh` adds new nodes. Example for a 'bedroom' node:
# api_encryption_key_radar:    "xjs2SqdPqUG44ew1D0vbNKNl5Cr8eejSscBgTnB6OX4="
# api_encryption_key_bedroom:   "PASTE_BASE64_32BYTE_HERE="
# api_encryption_key_kitchen:   "PASTE_BASE64_32BYTE_HERE="
#
# v1.2.0 (BL-07, dual-radar dispatcher): the per-node YAML's
# `substitutions.radar_type` selects which radar-specific
# include to !include (radar_ld2410.yaml for LD2410 / LD2410B /
# LD2410C, radar_ld2420.yaml for LD2420). The API encryption key
# is independent of the radar type — every node gets its own
# key, whether LD2410 or LD2420. The `scripts/new_node.sh
# <name> [radar_type]` script generates the key and sets
# radar_type in one step.

# ============================================================================
# Shared secrets (all nodes use the same Wi-Fi and OTA password)
# ============================================================================

# Wi-Fi SSID and password for the Pres-iot network.
# If a node needs a different SSID, override in that node's YAML:
#   wifi:
#     ssid: !secret wifi_ssid_bedroom
#     password: !secret wifi_password_bedroom
wifi_ssid: "YOUR_SSID"
wifi_password: "YOUR_PASSWORD"

# Fallback hotspot AP password (used when the D1 mini cannot reach
# the primary Wi-Fi). 8+ characters, ASCII only.
fallback_ap_password: "FallbackHotspot123"

# OTA update password. The v1.1.0 firmware has OTA password
# authentication enabled by default. Set this to a non-default
# value in production. (The v1.0.0 firmware used api-encryption-key
# authentication and no separate OTA password, hence the legacy
# `api_encryption_key` field is no longer used by the v1.1.0 build.)
ota_password: "otapass"
