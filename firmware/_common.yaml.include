# Shared firmware blocks for the dual-radar espRadar (v1.2.0+).
#
# This file is !include'd from every per-node firmware YAML
# (`firmware/<node>.yaml`, generated by `scripts/new_node.sh`).
# It carries the platform-level settings that DO NOT depend on which
# radar module is wired in: ESPHome core config, logger, API/OTA, Wi-Fi,
# web server, captive portal, the build-flag workaround.
#
# Radar-specific blocks (uart baud, sensor/binary_sensor/select/number/
# button entities) live in `firmware/radar_ld2410.yaml` and
# `firmware/radar_ld2420.yaml`. The per-node YAML picks one of them
# based on `substitutions.radar_type`.
#
# Why split: the LD2410 and LD2420 use DIFFERENT upstream ESPHome
# components (`ld2410:` vs `ld2420:`), DIFFERENT baud rates (256000 vs
# 115200), DIFFERENT entity schemas (9 gates × 2 vs 16 gates × 1), and
# DIFFERENT persistence models (every set_* auto-persists vs an
# apply_config button). Maintaining two separate per-radar blocks
# keeps each block self-contained and prevents a wrong-platform build
# from silently compiling.
#
# BL-07: this is the v1.2.0 dispatcher refactor (was v1.0.0 LD2420-only,
# then v1.1.0 LD2410-only). The dispatch is at the substitutions level,
# not at the include level — the per-node YAML !include's BOTH this
# common file AND one of the two radar-specific files.

# =====================================================================
# ESPHome core
# =====================================================================
esphome:
  name: ${device_name}
  friendly_name: ${friendly_name}
  min_version: 2025.11.0
  # BL-01b: toolchain-xtensa@3.x (gcc 10.3.0) workaround — applies to
  # BOTH LD2410 and LD2420 builds because both target the same D1 mini
  # toolchain. See RELEASE_CHECKLIST.md BL-01b for the full diagnosis.
  platformio_options:
    build_flags:
      - -include stddef.h
  on_boot:
    priority: 600
    then:
      - logger.log:
          level: INFO
          format: "ESPHome booted — espRadar v1.2.0 (radar_type=${radar_type})"
          tag: espRadar

esp8266:
  board: d1_mini
  framework:
    version: recommended

logger:
  level: INFO
  # 0 = UART0 silent. Required because the radar UART is on D7/D8
  # (GPIO13/15) and a log output on UART0 would either collide with the
  # radar (LD2410 / LD2420 don't accept TX on GPIO1/GPIO3 mid-protocol)
  # or break OTA (the bootloader needs GPIO1/GPIO3 free for handshake).
  baud_rate: ${log_baud}

# Native API for openHAB via seime/openhab-esphome binding.
# BL-06: the encryption key is per-node. Sharing a single key across
# multiple nodes causes "handshake failure" / "CONNECTION_CLOSED" in
# the openHAB log. Generated by `scripts/new_node.sh <name>` and
# written to `firmware/secrets.yaml` as `api_encryption_key_<name>:`
# `!secret` names cannot use substitutions, so each per-node YAML sets
# `api.encryption.key` itself.
api:
  reboot_timeout: 15min

ota:
  # ESPHome 2026.9.1 enables OTA password authentication by default.
  # The shared `!secret ota_password` lives in firmware/secrets.yaml.
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  power_save_mode: none
  fast_connect: true
  reboot_timeout: 5min
  # DHCP — host reservation by MAC on the router is the recommended way
  # to give each node a stable IP. See README → "Network setup".
  ap:
    # SSID limit is 32 — friendly_name is too verbose; use the short
    # device_name.
    ssid: "${device_name} Fallback"
    password: !secret fallback_ap_password

captive_portal:

web_server:
  port: 80
